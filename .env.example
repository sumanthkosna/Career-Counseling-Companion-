# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in your real credentials.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# IBM watsonx.ai API key (from IBM Cloud → Manage → Access → API keys)
WATSONX_API_KEY=your_ibm_watsonx_api_key_here

# watsonx.ai Project ID  (from watsonx.ai → Projects → your project → Manage)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai regional endpoint (change region if needed)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model to use for inference
# Options: ibm/granite-3-3-8b-instruct | ibm/granite-3-8b-instruct | ibm/granite-13b-instruct-v2
MODEL_ID=ibm/granite-3-3-8b-instruct
